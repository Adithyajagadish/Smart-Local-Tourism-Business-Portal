rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check path
    match /test/connection {
      allow get: if true;
    }

    // --- Reusable Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isHostAccount() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'host';
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'accountType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'accountType', 'avatarUrl', 'bio', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.accountType in ['traveller', 'host']
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['email', 'updatedAt'])
        && data.keys().hasOnly(['email', 'phone', 'payoutUpiId', 'payeeName', 'preferredPaymentApp', 'updatedAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('payoutUpiId' in data) || (data.payoutUpiId is string && data.payoutUpiId.size() <= 80))
        && (!('payeeName' in data) || (data.payeeName is string && data.payeeName.size() <= 80))
        && (!('preferredPaymentApp' in data) || (data.preferredPaymentApp in ['phonepe', 'gpay', 'both']))
        && data.updatedAt is timestamp;
    }

    function isValidListing(data) {
      return data.keys().hasAll([
          'hostId', 'hostName', 'category', 'title', 'description',
          'locationName', 'country', 'lat', 'lng', 'pricePerUnitInr',
          'unitLabel', 'maxGuests', 'amenities', 'photos', 'blockedDates',
          'isPublished', 'rating', 'reviewCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'hostId', 'hostName', 'category', 'title', 'description',
          'locationName', 'country', 'lat', 'lng', 'pricePerUnitInr',
          'unitLabel', 'maxGuests', 'amenities', 'photos', 'blockedDates',
          'isPublished', 'rating', 'reviewCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.hostId)
        && data.hostId == request.auth.uid
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 80
        && data.category in ['homestay', 'guide', 'cultural']
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 1500
        && data.locationName is string && data.locationName.size() >= 2 && data.locationName.size() <= 120
        && data.country is string && data.country.size() >= 2 && data.country.size() <= 80
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.pricePerUnitInr is number && data.pricePerUnitInr >= 100 && data.pricePerUnitInr <= 500000
        && data.unitLabel in ['night', 'session', 'person']
        && data.maxGuests is number && data.maxGuests >= 1 && data.maxGuests <= 30
        && data.amenities is list && data.amenities.size() <= 12
        && (data.amenities.size() == 0 || data.amenities[0] is string)
        && data.photos is list && data.photos.size() >= 1 && data.photos.size() <= 6
        && data.photos[0] is string
        && data.blockedDates is list && data.blockedDates.size() <= 120
        && (data.blockedDates.size() == 0 || isValidDateStr(data.blockedDates[0]))
        && data.isPublished is bool
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && data.reviewCount is number && data.reviewCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidListingPaymentDestination(data) {
      return data.keys().hasAll([
          'listingId', 'hostId', 'payeeName', 'paymentPhone', 'upiId',
          'preferredApp', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'listingId', 'hostId', 'payeeName', 'paymentPhone', 'upiId',
          'preferredApp', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.listingId)
        && isValidId(data.hostId)
        && data.hostId == request.auth.uid
        && data.payeeName is string && data.payeeName.size() >= 1 && data.payeeName.size() <= 80
        && data.paymentPhone is string && data.paymentPhone.size() >= 7 && data.paymentPhone.size() <= 32
        && data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 80
        && data.upiId.matches('^[^@\\s]+@[^@\\s]+$')
        && data.preferredApp in ['phonepe', 'gpay', 'both']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'listingId', 'listingTitle', 'listingLocation', 'listingCategory', 'listingPhoto',
          'hostId', 'hostName',
          'travellerId', 'travellerName',
          'checkInDate', 'checkOutDate', 'nightsOrUnits', 'guests',
          'subtotalInr', 'serviceFeeInr', 'totalAmountInr', 'hostNetPayoutInr',
          'displayCurrency', 'paymentMethod', 'upiHandle', 'transactionRef',
          'paymentStatus', 'bookingStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'listingId', 'listingTitle', 'listingLocation', 'listingCategory', 'listingPhoto',
          'hostId', 'hostName', 'hostPayeeName', 'hostPaymentPhone', 'hostUpiId',
          'travellerId', 'travellerName',
          'checkInDate', 'checkOutDate', 'nightsOrUnits', 'guests',
          'subtotalInr', 'serviceFeeInr', 'totalAmountInr', 'hostNetPayoutInr',
          'displayCurrency', 'paymentMethod', 'paymentMode', 'upiHandle', 'transactionRef',
          'paymentStatus', 'bookingStatus', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.listingId)
        && data.listingTitle is string && data.listingTitle.size() >= 1 && data.listingTitle.size() <= 120
        && data.listingLocation is string && data.listingLocation.size() >= 1 && data.listingLocation.size() <= 120
        && data.listingCategory in ['homestay', 'guide', 'cultural']
        && data.listingPhoto is string && data.listingPhoto.size() <= 220000
        && isValidId(data.hostId)
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 80
        && (!('hostPayeeName' in data) || (data.hostPayeeName is string && data.hostPayeeName.size() >= 1 && data.hostPayeeName.size() <= 80))
        && (!('hostPaymentPhone' in data) || (data.hostPaymentPhone is string && data.hostPaymentPhone.size() <= 32))
        && (!('hostUpiId' in data) || (data.hostUpiId is string && data.hostUpiId.size() >= 3 && data.hostUpiId.size() <= 80))
        && isValidId(data.travellerId)
        && data.travellerName is string && data.travellerName.size() >= 1 && data.travellerName.size() <= 80
        && isValidDateStr(data.checkInDate)
        && isValidDateStr(data.checkOutDate)
        && data.nightsOrUnits is number && data.nightsOrUnits >= 1 && data.nightsOrUnits <= 90
        && data.guests is number && data.guests >= 1 && data.guests <= 30
        && data.subtotalInr is number && data.subtotalInr >= 100
        && data.serviceFeeInr is number && data.serviceFeeInr >= 0
        && data.totalAmountInr is number && data.totalAmountInr >= 100
        && data.hostNetPayoutInr is number && data.hostNetPayoutInr >= 90
        && data.displayCurrency in ['INR', 'USD', 'EUR']
        && data.paymentMethod in ['phonepe', 'gpay']
        && (!('paymentMode' in data) || (data.paymentMode in ['live_upi', 'simulated']))
        && data.upiHandle is string && data.upiHandle.size() >= 3 && data.upiHandle.size() <= 80
        && data.transactionRef is string && data.transactionRef.size() >= 6 && data.transactionRef.size() <= 64
        && data.paymentStatus == 'paid'
        && data.bookingStatus in ['confirmed', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAvailabilitySlot(data) {
      return data.keys().hasAll(['listingId', 'hostId', 'travellerId', 'checkInDate', 'checkOutDate', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['listingId', 'hostId', 'travellerId', 'checkInDate', 'checkOutDate', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.listingId)
        && isValidId(data.hostId)
        && isValidId(data.travellerId)
        && isValidDateStr(data.checkInDate)
        && isValidDateStr(data.checkOutDate)
        && data.status in ['active', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'bio', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['accountType', 'updatedAt'])
        );
      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'payoutUpiId', 'payeeName', 'preferredPaymentApp', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /listings/{listingId} {
      allow get: if isValidId(listingId)
        && (existing().isPublished == true || (isSignedIn() && existing().hostId == request.auth.uid));
      allow list: if resource.data.isPublished == true
        || (isSignedIn() && resource.data.hostId == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(listingId)
        && isValidListing(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isHostAccount();
      allow update: if isSignedIn()
        && isValidId(listingId)
        && isValidListing(incoming())
        && existing().hostId == request.auth.uid
        && incoming().hostId == existing().hostId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'hostName', 'category', 'title', 'description', 'locationName',
            'country', 'lat', 'lng', 'pricePerUnitInr', 'unitLabel', 'maxGuests',
            'amenities', 'photos', 'isPublished', 'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly(['blockedDates', 'updatedAt'])
        );
      allow delete: if isSignedIn()
        && isValidId(listingId)
        && existing().hostId == request.auth.uid;
    }

    match /listing_payment_destinations/{listingId} {
      allow get: if isValidId(listingId) && isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(listingId)
        && isValidListingPaymentDestination(incoming())
        && incoming().listingId == listingId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isHostAccount()
        && existsAfter(/databases/$(database)/documents/listings/$(listingId))
        && getAfter(/databases/$(database)/documents/listings/$(listingId)).data.hostId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(listingId)
        && isValidListingPaymentDestination(incoming())
        && existing().hostId == request.auth.uid
        && incoming().listingId == existing().listingId
        && incoming().hostId == existing().hostId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['payeeName', 'paymentPhone', 'upiId', 'preferredApp', 'updatedAt']);
      allow delete: if isSignedIn()
        && isValidId(listingId)
        && existing().hostId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow get: if isSignedIn()
        && isValidId(bookingId)
        && (existing().travellerId == request.auth.uid || existing().hostId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.travellerId == request.auth.uid || resource.data.hostId == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().keys().hasAll(['hostPayeeName', 'hostPaymentPhone', 'hostUpiId', 'paymentMode'])
        && incoming().travellerId == request.auth.uid
        && incoming().bookingStatus == 'confirmed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().listingId.matches('^featured_[a-z0-9_]+$')
          || (
            exists(/databases/$(database)/documents/listings/$(incoming().listingId))
            && get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.hostId == incoming().hostId
          )
        )
        && existsAfter(/databases/$(database)/documents/listing_availability/$(bookingId));
      allow update: if isSignedIn()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().listingId == existing().listingId
        && incoming().hostId == existing().hostId
        && incoming().travellerId == existing().travellerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().bookingStatus == 'confirmed'
        && (
          (existing().hostId == request.auth.uid && incoming().bookingStatus in ['completed', 'cancelled'])
          || (existing().travellerId == request.auth.uid && incoming().bookingStatus == 'cancelled')
        )
        && incoming().diff(existing()).affectedKeys().hasOnly(['bookingStatus', 'updatedAt']);
      allow delete: if false;
    }

    match /listing_availability/{bookingId} {
      allow get: if isValidId(bookingId) && existing().status == 'active';
      allow list: if resource.data.status == 'active';
      allow create: if isSignedIn()
        && isValidId(bookingId)
        && isValidAvailabilitySlot(incoming())
        && incoming().travellerId == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/bookings/$(bookingId));
      allow update: if isSignedIn()
        && isValidId(bookingId)
        && isValidAvailabilitySlot(incoming())
        && incoming().listingId == existing().listingId
        && incoming().hostId == existing().hostId
        && incoming().travellerId == existing().travellerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'active'
        && incoming().status == 'cancelled'
        && (existing().hostId == request.auth.uid || existing().travellerId == request.auth.uid)
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }
  }
}
